NODE_ENV=development
PORT=3001
JWT_SECRET=super-secret-key-cambiar-en-produccion

# Configuración de Base de Datos (Supabase)
# Pega tu DATABASE_URL (Connection String) de Supabase aquí. 
# Si dejas esto comentado, el servidor usará SQLite por defecto de forma local.
# DATABASE_URL="postgresql://postgres.[tu-id]:[tu-password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Supabase Storage para Subida de Archivos
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_KEY="ey..."
SUPABASE_BUCKET="helpdesk-archivos"
